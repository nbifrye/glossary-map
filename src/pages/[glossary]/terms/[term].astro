---
import Blocks from "../../../components/Blocks.astro";
import ReferenceGroups from "../../../components/ReferenceGroups.astro";
import ReferenceNote from "../../../components/ReferenceNote.astro";
import Page from "../../../layouts/Page.astro";
import {
	loadSite,
	type SiteGlossary,
	type SiteTerm,
} from "../../../site/data.ts";
import { glossaryPath, termPath } from "../../../site/paths.ts";
import { applyReferences } from "../../../site/rich-text.ts";

export async function getStaticPaths() {
	const site = await loadSite();
	return site.flatMap((entry) =>
		entry.terms.map((item) => ({
			params: { glossary: entry.glossary.id, term: item.slug },
			props: { entry, item },
		})),
	);
}

interface Props {
	entry: SiteGlossary;
	item: SiteTerm;
}

const { entry, item } = Astro.props;
const { glossary } = entry;
const { term } = item;
const glossaryId = glossary.id;
const multiple = term.definitions.length > 1;

const target = (slug: string): SiteTerm => {
	const found = entry.bySlug.get(slug);
	if (found === undefined) {
		throw new Error(`${glossaryId}/${item.slug}: 参照先 ${slug} がありません`);
	}
	return found;
};

const definitions = term.definitions.map((definition, index) => ({
	definition,
	source: applyReferences(
		definition.source,
		term.references
			.filter((reference) => reference.definition === index)
			.map((reference) => ({
				start: reference.start,
				end: reference.end,
				href: termPath(glossaryId, target(reference.target.term).slug),
			})),
	),
	translation: applyReferences(definition.translation.content, []),
}));

/** 参照先ごとに、原文に現れる順に参照をまとめる */
const outgoing = [
	...Map.groupBy(term.references, (reference) => target(reference.target.term)),
].map(([to, references]) => ({ term: to, source: item, references }));
const incoming = [
	...Map.groupBy(entry.incoming.get(item.slug) ?? [], ({ source }) => source),
].map(([from, list]) => ({
	term: from,
	source: from,
	references: list.map(({ reference }) => reference),
}));
---

<Page title={`${term.heading} | ${glossary.title}`}>
	<nav aria-label="現在位置">
		<a href={glossaryPath(glossaryId)}>{glossary.title}</a>
	</nav>
	<h1 lang="en">{term.heading}</h1>
	{
		term.headingTranslation.text !== term.heading && (
			<p class="translation">{term.headingTranslation.text}</p>
		)
	}

	{
		definitions.map(({ definition, source, translation }, index) => (
			<section>
				<h2>{multiple ? `定義 ${index + 1}` : "定義"}</h2>
				<h3>原文</h3>
				<div lang="en">
					<Blocks blocks={source} />
				</div>
				<h3>訳文</h3>
				<div class="translation">
					<Blocks blocks={translation} />
				</div>
				<p>
					原典の該当箇所:{" "}
					{definition.location.url !== undefined ? (
						<a href={definition.location.url}>
							{definition.location.label ?? "原典を開く"}
						</a>
					) : (
						definition.location.label
					)}
				</p>
			</section>
		))
	}

	<section>
		<h2>参照</h2>
		<ReferenceNote />

		<h3>参照先 ({outgoing.length} 語)</h3>
		<p>この用語の定義が参照している用語です。</p>
		<ReferenceGroups glossary={glossaryId} groups={outgoing} />

		<h3>参照元 ({incoming.length} 語)</h3>
		<p>定義の中でこの用語を参照している用語です。</p>
		<ReferenceGroups glossary={glossaryId} groups={incoming} />
	</section>
</Page>
