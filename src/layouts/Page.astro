---
import { homePath } from "../site/paths.ts";

interface Props {
	title: string;
}

const { title } = Astro.props;
const siteName = "Glossary Map";
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title === siteName ? siteName : `${title} | ${siteName}`}</title>
	</head>
	<body>
		<header>
			<a href={homePath()}>{siteName}</a>
		</header>
		<main>
			<slot />
		</main>
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light dark;
		font-family: system-ui, sans-serif;
		line-height: 1.7;
	}

	body {
		margin: 0;
		padding: 1rem;
	}

	header,
	main {
		max-inline-size: 60rem;
		margin-inline: auto;
	}

	header {
		padding-block-end: 0.5rem;
		border-block-end: 1px solid light-dark(#ccc, #555);
	}

	h1,
	h2,
	h3 {
		line-height: 1.3;
		text-wrap: balance;
	}

	p,
	li,
	dd {
		text-wrap: pretty;
	}

	a {
		color: light-dark(#0b57d0, #8ab4f8);
	}

	.translation {
		color: light-dark(#444, #c4c4c4);
	}

	.note {
		padding: 0.5rem 1rem;
		border-inline-start: 4px solid light-dark(#888, #999);
		background: light-dark(#f3f3f3, #222);
	}

	dl.fields {
		display: grid;
		grid-template-columns: max-content 1fr;
		gap: 0.25rem 1rem;
	}

	dl.fields dd {
		margin: 0;
	}
</style>
