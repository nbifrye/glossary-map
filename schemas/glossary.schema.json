{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://nbifrye.github.io/glossary-map/schemas/glossary.schema.json",
	"title": "用語集",
	"type": "object",
	"additionalProperties": false,
	"required": ["id", "title", "source", "criteria"],
	"properties": {
		"$schema": { "type": "string" },
		"id": {
			"description": "用語集の ID。用語集のディレクトリ名と URL に使う",
			"$ref": "#/$defs/id"
		},
		"title": {
			"description": "用語集の名前",
			"$ref": "#/$defs/nonBlankString"
		},
		"source": {
			"description": "原典の書誌情報",
			"type": "object",
			"additionalProperties": false,
			"required": ["name", "version", "published", "url", "retrieved"],
			"properties": {
				"name": { "$ref": "#/$defs/nonBlankString" },
				"version": { "$ref": "#/$defs/nonBlankString" },
				"published": { "$ref": "#/$defs/date" },
				"url": { "$ref": "#/$defs/absoluteUrl" },
				"retrieved": { "$ref": "#/$defs/date" }
			}
		},
		"criteria": {
			"description": "参照と判定する基準の一覧",
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["id", "description"],
				"properties": {
					"id": { "$ref": "#/$defs/id" },
					"description": { "$ref": "#/$defs/nonBlankString" }
				}
			}
		}
	},
	"$defs": {
		"id": {
			"description": "小文字の英数字だけから成る語を、ハイフン 1 つずつでつないだ文字列",
			"type": "string",
			"pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
		},
		"nonBlankString": {
			"description": "空白以外の文字を含む文字列",
			"type": "string",
			"pattern": "\\S"
		},
		"date": {
			"description": "YYYY・YYYY-MM・YYYY-MM-DD のいずれかの形式の日付",
			"type": "string",
			"pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$"
		},
		"absoluteUrl": {
			"description": "http:// または https:// で始まる絶対 URL",
			"type": "string",
			"pattern": "^https?://"
		}
	}
}
