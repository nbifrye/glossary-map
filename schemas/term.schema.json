{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://nbifrye.github.io/glossary-map/schemas/term.schema.json",
	"title": "用語",
	"type": "object",
	"additionalProperties": false,
	"required": ["heading", "headingTranslation", "definitions", "references"],
	"properties": {
		"$schema": { "type": "string" },
		"heading": {
			"description": "用語の見出し。原典の表記のとおりに記録する",
			"type": "string",
			"minLength": 1
		},
		"headingTranslation": {
			"description": "見出しの訳文",
			"type": "object",
			"additionalProperties": false,
			"required": ["text", "sourceHash"],
			"properties": {
				"text": { "type": "string", "minLength": 1 },
				"sourceHash": { "$ref": "#/$defs/hash" }
			}
		},
		"definitions": {
			"type": "array",
			"minItems": 1,
			"items": { "$ref": "#/$defs/definition" }
		},
		"references": {
			"type": "array",
			"items": { "$ref": "#/$defs/reference" }
		}
	},
	"$defs": {
		"hash": {
			"description": "SHA-256 の値を小文字の 16 進数で表した文字列",
			"type": "string",
			"pattern": "^[0-9a-f]{64}$"
		},
		"definition": {
			"type": "object",
			"additionalProperties": false,
			"required": ["location", "source", "translation"],
			"properties": {
				"location": {
					"description": "原典の該当箇所。リンクか記載位置の少なくとも一方を記録する",
					"type": "object",
					"additionalProperties": false,
					"minProperties": 1,
					"properties": {
						"url": { "type": "string", "pattern": "^https?://" },
						"label": { "type": "string", "minLength": 1 }
					}
				},
				"source": { "$ref": "#/$defs/blocks" },
				"translation": {
					"type": "object",
					"additionalProperties": false,
					"required": ["content", "sourceHash"],
					"properties": {
						"content": { "$ref": "#/$defs/blocks" },
						"sourceHash": { "$ref": "#/$defs/hash" }
					}
				}
			}
		},
		"reference": {
			"type": "object",
			"additionalProperties": false,
			"required": ["definition", "target", "start", "end", "text", "criterion"],
			"properties": {
				"definition": {
					"description": "参照元の定義。definitions の 0 から始まる番号",
					"type": "integer",
					"minimum": 0
				},
				"target": {
					"type": "object",
					"additionalProperties": false,
					"required": ["glossary", "term"],
					"properties": {
						"glossary": { "type": "string", "minLength": 1 },
						"term": { "type": "string", "minLength": 1 }
					}
				},
				"start": { "type": "integer", "minimum": 0 },
				"end": { "type": "integer", "minimum": 1 },
				"text": { "type": "string", "minLength": 1 },
				"criterion": { "type": "string", "minLength": 1 }
			}
		},
		"blocks": {
			"type": "array",
			"minItems": 1,
			"items": { "$ref": "#/$defs/block" }
		},
		"block": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "children"],
					"properties": {
						"type": { "const": "paragraph" },
						"children": { "$ref": "#/$defs/inlines" }
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "ordered", "items"],
					"properties": {
						"type": { "const": "list" },
						"ordered": { "type": "boolean" },
						"items": {
							"type": "array",
							"minItems": 1,
							"items": { "$ref": "#/$defs/blocks" }
						}
					}
				}
			]
		},
		"inlines": {
			"type": "array",
			"minItems": 1,
			"items": { "$ref": "#/$defs/inline" }
		},
		"inline": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "value"],
					"properties": {
						"type": { "const": "text" },
						"value": { "type": "string", "minLength": 1 }
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "children"],
					"properties": {
						"type": { "const": "emphasis" },
						"children": { "$ref": "#/$defs/inlines" }
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "href", "children"],
					"properties": {
						"type": { "const": "link" },
						"href": { "type": "string", "minLength": 1 },
						"children": { "$ref": "#/$defs/inlines" }
					}
				}
			]
		}
	}
}
