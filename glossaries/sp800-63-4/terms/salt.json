			"source": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "text",
							"value": "A non-secret value used in a cryptographic process, usually to ensure that the results of computations for one instance cannot be reused by an attacker."
						}
					]
				}
			],
			"translation": {
				"content": [
					{
						"type": "paragraph",
						"children": [
							{
								"type": "text",
								"value": "暗号のプロセスで使われる秘密でない値。通常は、あるインスタンスの計算結果を攻撃者が再利用できないようにするために使われる。"
							}
						]
					}
				],
				"sourceHash": "24629a54b4f08341060773264e76b6bd8cb6b1ba4564a2791f6144605b31b765"
			}
		}
