{
	"$schema": "../../../schemas/term.schema.json",
	"heading": "challenge-response protocol",
	"headingTranslation": {
		"text": "チャレンジレスポンスプロトコル",
		"sourceHash": "0fc6085c8b273042812a291d065a23bd951bf228d23df797672f6a49287c9bc6"
	},
	"definitions": [
		{
			"location": {
				"url": "https://pages.nist.gov/800-63-4/sp800-63.html#def"
			},
			"source": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "text",
							"value": "An "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "authentication protocol"
								}
							]
						},
						{
							"type": "text",
							"value": " in which the "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "verifier"
								}
							]
						},
						{
							"type": "text",
							"value": " sends the "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "claimant"
								}
							]
						},
						{
							"type": "text",
							"value": " a challenge (e.g., a random value or "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "nonce"
								}
							]
						},
						{
							"type": "text",
							"value": ") that the claimant combines with a secret (e.g., by hashing the challenge and a "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "shared secret"
								}
							]
						},
						{
							"type": "text",
							"value": " together or by applying a "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "private-key"
								}
							]
						},
						{
							"type": "text",
							"value": " operation to the challenge) to generate a response that is sent to the verifier. The verifier can independently verify the response generated by the claimant (e.g., by recomputing the hash of the challenge and the shared secret and comparing it to the response or performing a public-key operation on the response) and establish that the claimant possesses and controls the secret."
						}
					]
				}
			],
			"translation": {
				"content": [
					{
						"type": "paragraph",
						"children": [
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "verifier"
									}
								]
							},
							{
								"type": "text",
								"value": " が "
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "claimant"
									}
								]
							},
							{
								"type": "text",
								"value": " にチャレンジ (例: ランダムな値や"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "ノンス"
									}
								]
							},
							{
								"type": "text",
								"value": ") を送り、claimant がそれをシークレットと組み合わせて (例: チャレンジと"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "共有シークレット"
									}
								]
							},
							{
								"type": "text",
								"value": "をまとめてハッシュ化する、またはチャレンジに"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "秘密鍵"
									}
								]
							},
							{
								"type": "text",
								"value": "による操作を適用する) 応答を生成し、verifier に送る"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "認証プロトコル"
									}
								]
							},
							{
								"type": "text",
								"value": "。verifier は、claimant が生成した応答を独立に検証し (例: チャレンジと共有シークレットのハッシュを計算し直して応答と比較する、または応答に公開鍵による操作を行う)、claimant がシークレットを所持し管理していることを確認できる。"
							}
						]
					}
				],
				"sourceHash": "24a2f6aa8eef82cfe7ed297de432e224b85db41f43002682b0ab7567987e212d"
			}
		}
	],
