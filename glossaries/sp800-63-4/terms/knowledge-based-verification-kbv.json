							"children": [
								{
									"type": "text",
									"value": "claimed identity"
								}
							]
						},
						{
							"type": "text",
							"value": " of an "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "applicant"
								}
							]
						},
						{
							"type": "text",
							"value": ". KBV does not include collecting personal "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "attributes"
								}
							]
						},
						{
							"type": "text",
							"value": " for the purposes of "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "identity resolution"
								}
							]
						},
						{
							"type": "text",
							"value": "."
						}
					]
				}
			],
			"translation": {
