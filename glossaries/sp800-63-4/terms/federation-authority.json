			"source": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "text",
							"value": "A party that facilitates the establishment and management of one or more "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "trust agreements"
								}
							]
						},
						{
							"type": "text",
							"value": " between federated parties. The federation authority can also provide other services, such as a "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "federation proxy"
								}
							]
						},
						{
							"type": "text",
							"value": ", discovery and registration support, and conformance evaluation."
						}
					]
				}
			],
			"translation": {
				"content": [
					{
						"type": "paragraph",
						"children": [
							{
								"type": "text",
								"value": "フェデレーションに参加する当事者の間で、1 つ以上の "
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "trust agreement"
									}
								]
							},
							{
								"type": "text",
								"value": " の確立と管理を促進する当事者。federation authority は、"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "フェデレーションプロキシ"
									}
								]
							},
							{
								"type": "text",
								"value": "・ディスカバリーと登録の支援・適合性評価などのほかのサービスを提供することもある。"
							}
						]
					}
				],
				"sourceHash": "7b55072bce11277cce54d639fd4d0b923e0aa597f58485ccb4b5abdfa118b00c"
			}
		}
