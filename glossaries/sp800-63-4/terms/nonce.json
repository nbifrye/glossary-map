{
	"$schema": "../../../schemas/term.schema.json",
	"heading": "nonce",
	"headingTranslation": {
		"text": "ノンス",
		"sourceHash": "78377b525757b494427f89014f97d79928f3938d14eb51e20fb5dec9834eb304"
	},
	"definitions": [
		{
			"location": {
				"url": "https://pages.nist.gov/800-63-4/sp800-63.html#def"
			},
			"source": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "text",
							"value": "A value used in security protocols that is never repeated with the same key. For example, nonces used as challenges in "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "challenge-response authentication protocols"
								}
							]
						},
						{
							"type": "text",
							"value": " must not be repeated until "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "authentication keys"
								}
							]
						},
						{
							"type": "text",
							"value": " are changed. Otherwise, there is a possibility of a "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "replay attack"
								}
							]
						},
						{
							"type": "text",
							"value": ". Using a nonce as a challenge is a different requirement than a random challenge because a nonce is not necessarily unpredictable."
						}
					]
				}
			],
			"translation": {
				"content": [
					{
						"type": "paragraph",
						"children": [
							{
								"type": "text",
								"value": "セキュリティプロトコルで使われる値で、同じ鍵とともに繰り返し使われることのないもの。たとえば、"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "チャレンジレスポンス型の認証プロトコル"
									}
								]
							},
							{
								"type": "text",
								"value": "でチャレンジとして使われるノンスは、"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "認証鍵"
									}
								]
							},
							{
								"type": "text",
								"value": "が変更されるまで繰り返してはならない。そうしなければ、"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "リプレイ攻撃"
									}
								]
							},
							{
								"type": "text",
								"value": "を受ける可能性がある。ノンスは必ずしも予測不可能ではないため、ノンスをチャレンジとして使うことは、ランダムなチャレンジとは異なる要件である。"
							}
						]
					}
				],
				"sourceHash": "9978933396cb599e518f61f64ed8d32eb9fb30f471ebcfd926f99060cdfb936a"
			}
		}
	],
