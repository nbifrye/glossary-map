{
	"$schema": "../../../schemas/term.schema.json",
	"heading": "credential",
	"headingTranslation": {
		"text": "クレデンシャル",
		"sourceHash": "e265b6f564601a1fe8dc42785cd18a868bd8013eb5899560e79248767a683e6b"
	},
	"definitions": [
		{
			"location": {
				"url": "https://pages.nist.gov/800-63-4/sp800-63.html#def"
			},
			"source": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "text",
							"value": "An object or data structure that authoritatively binds an identity — via an "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "identifier"
								}
							]
						},
						{
							"type": "text",
							"value": " — and (optionally) additional "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "attributes"
								}
							]
						},
						{
							"type": "text",
							"value": " to at least one "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "authenticator"
								}
							]
						},
						{
							"type": "text",
							"value": " that is possessed and controlled by a "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "subscriber"
								}
							]
						},
						{
							"type": "text",
							"value": ". A credential is issued, stored, and maintained by the "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "CSP"
								}
							]
						},
						{
							"type": "text",
							"value": ". Copies of information from the credential can be possessed by the subscriber, typically in the form of one or more digital certificates that are often contained in an authenticator along with their associated "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "private keys"
								}
							]
						},
						{
							"type": "text",
							"value": "."
						}
					]
				}
			],
			"translation": {
				"content": [
					{
						"type": "paragraph",
						"children": [
							{
								"type": "text",
								"value": "アイデンティティを、"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "識別子"
									}
								]
							},
							{
								"type": "text",
								"value": "を介して、また任意で追加の"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "属性"
									}
								]
							},
							{
								"type": "text",
								"value": "とともに、"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "subscriber"
									}
								]
							},
							{
								"type": "text",
								"value": " が所持し管理する 1 つ以上の"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "認証器"
									}
								]
							},
							{
								"type": "text",
								"value": "に権威をもってバインドするオブジェクトまたはデータ構造。クレデンシャルは、"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "CSP"
									}
								]
							},
							{
								"type": "text",
								"value": " が発行・保存・維持する。クレデンシャルの情報の写しを subscriber が所持することもでき、通常は、関連する"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "秘密鍵"
									}
								]
							},
							{
								"type": "text",
								"value": "とともに認証器に格納されることが多い 1 つ以上のデジタル証明書の形をとる。"
							}
						]
					}
				],
				"sourceHash": "b79a4edc4403dc9f68767a4116609d17b79440e13073ff49cfeae4859cd49b1a"
			}
		}
	],
