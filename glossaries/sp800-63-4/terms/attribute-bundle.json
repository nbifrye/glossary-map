			"source": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "text",
							"value": "A package of "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "attribute values"
								}
							]
						},
						{
							"type": "text",
							"value": " and "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "derived attribute values"
								}
							]
						},
						{
							"type": "text",
							"value": " from a "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "CSP"
								}
							]
						},
						{
							"type": "text",
							"value": ". The package has the necessary cryptographic protection to allow for the "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "validation"
								}
							]
						},
						{
							"type": "text",
							"value": " of the bundle independent from interaction with the CSP or "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "IdP"
								}
							]
						},
						{
							"type": "text",
							"value": ". Attribute bundles are often used with subscriber-controlled wallets."
						}
					]
				}
			],
			"translation": {
				"content": [
					{
						"type": "paragraph",
						"children": [
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "CSP"
									}
								]
							},
							{
								"type": "text",
								"value": " が発行する、"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "属性値"
									}
								]
							},
							{
								"type": "text",
								"value": "と"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "派生属性値"
									}
								]
							},
							{
								"type": "text",
								"value": "のパッケージ。このパッケージには、CSP や "
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "IdP"
									}
								]
							},
							{
								"type": "text",
								"value": " とのやり取りなしにバンドルの"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "妥当性確認"
									}
								]
							},
							{
								"type": "text",
								"value": "を行えるようにするための、必要な暗号による保護が施されている。属性バンドルは、加入者管理ウォレットとともに使われることが多い。"
							}
						]
					}
				],
