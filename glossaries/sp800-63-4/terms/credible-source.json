			"source": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "text",
							"value": "An entity that can provide or validate the accuracy of "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "identity evidence"
								}
							]
						},
						{
							"type": "text",
							"value": " and "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "attribute"
								}
							]
						},
						{
							"type": "text",
							"value": " information. A credible source has access to attribute information that was validated through an "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "identity proofing"
								}
							]
						},
						{
							"type": "text",
							"value": " process or that can be traced to an "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "authoritative source"
								}
							]
						},
						{
							"type": "text",
							"value": ", or it maintains identity attribute information obtained from multiple sources that is checked for data correlation for accuracy, consistency, and currency."
						}
					]
				}
			],
			"translation": {
				"content": [
					{
						"type": "paragraph",
						"children": [
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "identity evidence"
									}
								]
							},
							{
								"type": "text",
								"value": " と"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "属性"
									}
								]
							},
							{
								"type": "text",
								"value": "の情報を提供できる、またはその正確さを確認できる組織。credible source は、"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "身元確認"
									}
								]
							},
							{
								"type": "text",
								"value": "のプロセスで妥当性確認された属性の情報か、"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "authoritative source"
									}
								]
							},
							{
								"type": "text",
								"value": " までたどれる属性の情報にアクセスできるか、または複数の情報源から取得し、正確さ・一貫性・最新性についてデータの相関を確認したアイデンティティの属性の情報を保持している。"
							}
						]
					}
