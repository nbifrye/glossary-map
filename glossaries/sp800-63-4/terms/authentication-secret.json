{
	"$schema": "../../../schemas/term.schema.json",
	"heading": "authentication secret",
	"headingTranslation": {
		"text": "認証シークレット",
		"sourceHash": "30c4c5e34fb262748d1b837f98d3c08c815e21521980aff4f1d8105ed0b86705"
	},
	"definitions": [
		{
			"location": {
				"url": "https://pages.nist.gov/800-63-4/sp800-63.html#def"
			},
			"source": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "text",
							"value": "A generic term for any secret value that is used to verify the "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "subscriber"
								}
							]
						},
						{
							"type": "text",
							"value": " in an "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "authentication protocol"
								}
							]
						},
						{
							"type": "text",
							"value": ". These are further divided into "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "short-term authentication secrets"
								}
							]
						},
						{
							"type": "text",
							"value": ", which are only useful to an attacker for a limited period of time, and "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "long-term authentication secrets"
								}
							]
						},
						{
							"type": "text",
							"value": ", which allow an attacker to impersonate the subscriber until they are manually reset. The "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "authenticator"
								}
							]
						},
						{
							"type": "text",
							"value": " secret is the canonical example of a long-term authentication secret, while the "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "authenticator output"
								}
							]
						},
						{
							"type": "text",
							"value": " — if it is different from the authenticator secret — is usually a short-term authentication secret."
						}
					]
				}
			],
			"translation": {
				"content": [
					{
						"type": "paragraph",
						"children": [
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "認証プロトコル"
									}
								]
							},
							{
								"type": "text",
								"value": "で "
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "subscriber"
									}
								]
							},
							{
								"type": "text",
								"value": " を検証するために使われる、あらゆる秘密の値の総称。これはさらに、攻撃者にとって限られた期間だけ役立つ"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "短期の認証シークレット"
									}
								]
							},
							{
								"type": "text",
								"value": "と、手動でリセットされるまで攻撃者が subscriber になりすますことを可能にする"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "長期の認証シークレット"
									}
								]
							},
							{
								"type": "text",
								"value": "に分けられる。"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "認証器"
									}
								]
							},
							{
								"type": "text",
								"value": "のシークレットは長期の認証シークレットの典型例であり、"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "認証器出力"
									}
								]
							},
							{
								"type": "text",
								"value": "は、認証器のシークレットと異なる場合、通常は短期の認証シークレットである。"
							}
						]
					}
				],
				"sourceHash": "9e34287153160d96a77e6a1d3c37394c7fd8ccafd5cfb24039ec251a50e621af"
			}
		}
	],
