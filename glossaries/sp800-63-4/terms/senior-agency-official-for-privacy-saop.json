			"source": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "text",
							"value": "Person responsible for ensuring that an agency complies with privacy requirements, manages privacy risks, and considers the privacy impacts of all agency actions and policies that involve "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "personal information"
								}
							]
						},
						{
							"type": "text",
							"value": "."
						}
					]
				}
			],
			"translation": {
				"content": [
					{
						"type": "paragraph",
						"children": [
							{
								"type": "text",
								"value": "機関がプライバシーの要件を遵守し、プライバシーのリスクを管理し、"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "個人情報"
									}
								]
							},
							{
								"type": "text",
								"value": "に関わる機関のすべての活動とポリシーがプライバシーに与える影響を考慮することを確実にする責任者。"
							}
						]
					}
				],
