			"source": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "text",
							"value": "A representative of the "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "applicant"
								}
							]
						},
						{
							"type": "text",
							"value": " who can vouch for the identity of the applicant, specific "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "attributes"
								}
							]
						},
						{
							"type": "text",
							"value": " related to the applicant, or conditions relative to the context of the individual (e.g., emergency status, homelessness)."
						}
					]
				}
			],
			"translation": {
				"content": [
					{
						"type": "paragraph",
						"children": [
							{
								"type": "text",
								"value": "申請者のアイデンティティ、申請者に関する特定の"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "属性"
									}
								]
							},
							{
								"type": "text",
								"value": "、または個人の状況に関する条件 (例: 緊急事態にあること、住居がないこと) を保証できる、"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "申請者"
									}
								]
							},
							{
