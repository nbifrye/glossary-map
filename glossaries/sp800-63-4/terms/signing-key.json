	"heading": "signing key",
	"headingTranslation": {
		"text": "署名鍵",
		"sourceHash": "fc56bdea31de8d3c810c4431007f3f1c19874576e8d8c188dc7aba0343305fe7"
	},
	"definitions": [
		{
			"location": {
				"url": "https://pages.nist.gov/800-63-4/sp800-63.html#def"
			},
			"source": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "text",
							"value": "The cryptographic key used to create a signature. In asymmetric cryptography, the signing key refers to the "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "private key"
								}
							]
						},
						{
							"type": "text",
							"value": " of the cryptographic key pair. In symmetric cryptography, the signing key is the "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "symmetric key"
								}
							]
						},
						{
							"type": "text",
							"value": "."
						}
					]
				}
			],
			"translation": {
				"content": [
					{
						"type": "paragraph",
						"children": [
							{
								"type": "text",
								"value": "署名を作成するために使われる暗号鍵。非対称暗号では、署名鍵は暗号鍵のペアのうちの"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "秘密鍵"
									}
								]
							},
							{
								"type": "text",
								"value": "を指す。対称暗号では、署名鍵は"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "対称鍵"
									}
								]
							},
							{
								"type": "text",
								"value": "である。"
							}
						]
					}
				],
				"sourceHash": "d9a04e0db504ca1be5672482b85d41c857851b0fbb1c8ac060c7a80d99cdbf89"
			}
		}
	],
