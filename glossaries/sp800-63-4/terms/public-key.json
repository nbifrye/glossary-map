{
	"$schema": "../../../schemas/term.schema.json",
	"heading": "public key",
	"headingTranslation": {
		"text": "公開鍵",
		"sourceHash": "f569a86d3c2c8d7dda26b5dbea20bd5c19eeb35dfc63fdb724bac4f21c227850"
	},
	"definitions": [
		{
			"location": {
				"url": "https://pages.nist.gov/800-63-4/sp800-63.html#def"
			},
			"source": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "text",
							"value": "A cryptographic key used with a public-key cryptographic algorithm that is uniquely associated with an entity and that may be made public. In an asymmetric-key (public-key) cryptosystem, the public key has a corresponding "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "private key"
								}
							]
						},
						{
							"type": "text",
							"value": ". The public key may be known by anyone and, depending on the algorithm, may be used to:"
						}
					]
				},
				{
					"type": "list",
					"ordered": true,
					"items": [
						[
							{
								"type": "paragraph",
								"children": [
									{
										"type": "text",
										"value": "Verify a digital signature that was generated using the corresponding private key,"
									}
								]
							}
						],
						[
							{
								"type": "paragraph",
								"children": [
									{
										"type": "text",
										"value": "Encrypt keys that can be decrypted using the corresponding private key, or"
									}
								]
							}
						],
						[
							{
								"type": "paragraph",
								"children": [
									{
										"type": "text",
										"value": "Compute a shared secret during a key-agreement transaction."
									}
								]
							}
						]
					]
				}
			],
			"translation": {
				"content": [
					{
						"type": "paragraph",
						"children": [
							{
								"type": "text",
								"value": "公開鍵暗号アルゴリズムとともに使われる暗号鍵で、ある実体に一意に関連付けられ、公開してもよいもの。非対称鍵 (公開鍵) 暗号システムでは、公開鍵には対応する"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "秘密鍵"
									}
								]
							},
							{
								"type": "text",
								"value": "がある。公開鍵は誰に知られてもよく、アルゴリズムによっては次の用途に使われる。"
							}
						]
					},
					{
						"type": "list",
						"ordered": true,
						"items": [
							[
								{
									"type": "paragraph",
									"children": [
										{
											"type": "text",
											"value": "対応する秘密鍵を使って生成されたデジタル署名を検証する"
										}
									]
								}
							],
							[
								{
									"type": "paragraph",
									"children": [
										{
											"type": "text",
											"value": "対応する秘密鍵で復号できる鍵を暗号化する"
										}
									]
								}
							],
							[
								{
									"type": "paragraph",
									"children": [
										{
											"type": "text",
											"value": "鍵合意のトランザクションで共有シークレットを計算する"
										}
									]
								}
							]
						]
					}
				],
				"sourceHash": "fe9d1bb31d0cecd9c31eb96868ec1e801bcfbc9230304d5db0c3054f3c3695ab"
			}
		}
	],
