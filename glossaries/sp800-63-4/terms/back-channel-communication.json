						}
					]
				}
			],
			"translation": {
				"content": [
					{
						"type": "paragraph",
						"children": [
							{
								"type": "text",
								"value": "ブラウザーなどの仲介者を経由するリダイレクトを使わず、直接の接続に依存する 2 つのシステム間の通信。"
