			"source": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "text",
							"value": "A digital document issued and digitally signed by the "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "private key"
								}
							]
						},
						{
							"type": "text",
							"value": " of a certificate authority that binds an "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "identifier"
								}
							]
						},
						{
							"type": "text",
							"value": " to a subscriber’s "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "public key"
								}
							]
						},
						{
							"type": "text",
							"value": ". The certificate indicates that the "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "subscriber"
								}
							]
						},
						{
							"type": "text",
							"value": " identified in the certificate has sole control of and access to the "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "private key"
								}
							]
						},
						{
							"type": "text",
							"value": ". See also "
						},
						{
							"type": "link",
							"href": "https://pages.nist.gov/800-63-4/sp800-63/references/#ref-RFC5280",
							"children": [
								{
									"type": "text",
									"value": "[RFC5280]"
								}
							]
						},
						{
							"type": "text",
							"value": "."
						}
					]
				}
			],
			"translation": {
				"content": [
					{
						"type": "paragraph",
						"children": [
							{
								"type": "text",
								"value": "認証局の"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "秘密鍵"
									}
								]
							},
							{
								"type": "text",
								"value": "によって発行され、デジタル署名された電子文書で、"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "識別子"
									}
								]
							},
							{
								"type": "text",
								"value": "を subscriber の"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "公開鍵"
									}
								]
							},
							{
								"type": "text",
								"value": "にバインドするもの。証明書は、証明書で識別される "
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "subscriber"
									}
								]
							},
							{
								"type": "text",
								"value": " が"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "秘密鍵"
									}
								]
							},
							{
								"type": "text",
								"value": "を単独で管理し、単独でアクセスできることを示す。"
							},
							{
								"type": "link",
								"href": "https://pages.nist.gov/800-63-4/sp800-63/references/#ref-RFC5280",
								"children": [
									{
										"type": "text",
										"value": "[RFC5280]"
									}
								]
							},
							{
								"type": "text",
								"value": " も参照。"
							}
						]
					}
				],
				"sourceHash": "27b77eafa9fdacf4a3464ed7b07a3d739f8eefdefd016366838a4d3adbf5fbc0"
