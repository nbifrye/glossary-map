	"heading": "public-key certificate",
	"headingTranslation": {
		"text": "公開鍵証明書",
		"sourceHash": "9d78db4a5ef01e2887a965020322a386e0847cf8308bbeee782fdc489db280e6"
	},
	"definitions": [
		{
