	"heading": "trust anchor",
	"headingTranslation": {
		"text": "トラストアンカー",
		"sourceHash": "8ead662fe78663f5f733a16aa8d56dd4097c06ee8611b5ffa23ea08847cab921"
	},
	"definitions": [
		{
			"location": {
