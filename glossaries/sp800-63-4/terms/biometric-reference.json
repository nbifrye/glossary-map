			"source": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "text",
							"value": "One or more stored "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "biometric samples"
								}
							]
						},
						{
							"type": "text",
							"value": ", templates, or models attributed to an individual and used as the object of biometric comparison in a database, such as a facial image stored digitally on a passport, fingerprint minutiae template on a National ID card, or Gaussian Mixture Model for speaker recognition."
						}
					]
				}
			],
			"translation": {
				"content": [
					{
						"type": "paragraph",
						"children": [
							{
								"type": "text",
								"value": "個人に帰属し、データベース内で生体照合の対象として使われる、保存された 1 つ以上の"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "生体サンプル"
									}
								]
							},
							{
								"type": "text",
								"value": "・テンプレート・モデル。たとえば、パスポートにデジタルで保存された顔画像、国民 ID カード上の指紋の特徴点のテンプレート、話者認識のためのガウス混合モデルなどがある。"
							}
						]
					}
				],
