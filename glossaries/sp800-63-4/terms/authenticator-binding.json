							},
							{
								"type": "text",
								"value": "でアカウントに関連付けられた"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "加入者"
									}
								]
							},
							{
								"type": "text",
								"value": "を認証できるようになる。"
							}
						]
					}
				],
				"sourceHash": "d630de8b5d317dd83ddbfe7bfe867b7fd24fe3bc448e44a42b53bc86f92e691e"
