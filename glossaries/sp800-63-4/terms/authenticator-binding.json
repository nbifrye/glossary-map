			"source": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "text",
							"value": "The establishment of an association between a specific "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "authenticator"
								}
							]
						},
						{
							"type": "text",
							"value": " and a "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "subscriber account"
								}
							]
						},
						{
							"type": "text",
							"value": " that allows the "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "authenticator"
								}
							]
						},
						{
							"type": "text",
							"value": " to authenticate the "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "subscriber"
								}
							]
						},
						{
							"type": "text",
							"value": " associated with the account, possibly in conjunction with other authenticators."
						}
					]
				}
			],
			"translation": {
				"content": [
					{
						"type": "paragraph",
						"children": [
							{
								"type": "text",
								"value": "特定の"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "認証器"
									}
								]
							},
							{
								"type": "text",
								"value": "と"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "加入者アカウント"
									}
								]
							},
							{
								"type": "text",
								"value": "の間に関連付けを確立すること。これにより、場合によってはほかの認証器と組み合わせて、その"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "認証器"
									}
