	"heading": "authentication protocol",
	"headingTranslation": {
		"text": "認証プロトコル",
		"sourceHash": "30d624c372ed223c9509bcce21b3e15e0db7318dc2caa010e9669e255a6a89d5"
	},
	"definitions": [
		{
