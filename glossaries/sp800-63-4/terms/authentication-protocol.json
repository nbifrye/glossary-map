			},
			"source": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "text",
							"value": "A defined sequence of messages between a "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "claimant"
								}
							]
						},
						{
							"type": "text",
							"value": " and a "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "verifier"
								}
							]
						},
						{
							"type": "text",
							"value": " that demonstrates that the claimant has possession and control of one or more valid "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "authenticators"
								}
							]
						},
						{
							"type": "text",
							"value": " to establish their identity and, optionally, demonstrates that the claimant is communicating with the intended verifier."
						}
					]
				}
			],
			"translation": {
				"content": [
					{
						"type": "paragraph",
						"children": [
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "claimant"
									}
								]
							},
							{
								"type": "text",
								"value": " と "
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "verifier"
									}
								]
							},
							{
								"type": "text",
								"value": " の間で交わされる定められた一連のメッセージ。claimant が有効な 1 つ以上の"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "認証器"
									}
								]
							},
							{
								"type": "text",
								"value": "を所持し管理していることを示してアイデンティティを確立し、任意で、claimant が意図した verifier と通信していることを示す。"
							}
						]
					}
				],
