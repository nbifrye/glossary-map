{
	"$schema": "../../../schemas/term.schema.json",
	"heading": "private key",
	"headingTranslation": {
		"text": "秘密鍵",
		"sourceHash": "d7cd482cb958ef235f5d26e852472ba1ee5309eab18e3c6712181a7bfae80000"
	},
	"definitions": [
		{
			"location": {
				"url": "https://pages.nist.gov/800-63-4/sp800-63a.html#def-and-acr"
			},
			"source": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "text",
							"value": "A cryptographic key used with a public-key cryptographic algorithm that is uniquely associated with an entity and is not made public. In an asymmetric-key (public-key) cryptosystem, the private key has a corresponding "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "public key"
								}
							]
						},
						{
							"type": "text",
							"value": ". Depending on the algorithm, the private key may be used to:"
						}
					]
				},
				{
					"type": "list",
					"ordered": true,
					"items": [
						[
							{
								"type": "paragraph",
								"children": [
									{
										"type": "text",
										"value": "Compute the corresponding public key,"
									}
								]
							}
						],
						[
							{
								"type": "paragraph",
								"children": [
									{
										"type": "text",
										"value": "Compute a digital signature that may be verified by the corresponding public key,"
									}
								]
							}
						],
						[
							{
								"type": "paragraph",
								"children": [
									{
										"type": "text",
										"value": "Decrypt keys that were encrypted by the corresponding public key, or"
									}
								]
							}
						],
						[
							{
								"type": "paragraph",
								"children": [
									{
										"type": "text",
										"value": "Compute a shared secret during a key-agreement transaction."
									}
								]
							}
						]
					]
				}
			],
			"translation": {
				"content": [
					{
						"type": "paragraph",
						"children": [
							{
								"type": "text",
								"value": "公開鍵暗号アルゴリズムとともに使われる暗号鍵で、ある実体に一意に関連付けられ、公開されないもの。非対称鍵 (公開鍵) 暗号システムでは、秘密鍵には対応する"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "公開鍵"
									}
								]
							},
							{
								"type": "text",
								"value": "がある。アルゴリズムによっては、秘密鍵は次の用途に使われる。"
							}
						]
					},
					{
						"type": "list",
						"ordered": true,
						"items": [
							[
								{
									"type": "paragraph",
									"children": [
										{
											"type": "text",
											"value": "対応する公開鍵を計算する"
										}
									]
								}
							],
							[
								{
									"type": "paragraph",
									"children": [
										{
											"type": "text",
											"value": "対応する公開鍵で検証できるデジタル署名を計算する"
										}
									]
								}
							],
							[
								{
									"type": "paragraph",
									"children": [
										{
											"type": "text",
											"value": "対応する公開鍵で暗号化された鍵を復号する"
										}
									]
								}
							],
							[
								{
									"type": "paragraph",
									"children": [
										{
											"type": "text",
											"value": "鍵合意のトランザクションで共有シークレットを計算する"
										}
									]
								}
							]
						]
					}
				],
				"sourceHash": "c70133d3134b24b0e69f6a8e8b47eb337abea7d9adc56a8e70b08b7348ddc609"
			}
		}
	],
