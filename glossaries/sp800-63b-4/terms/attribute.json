						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "subscriber"
								}
							]
						},
						{
							"type": "text",
							"value": " (e.g., name, date of birth, address)."
						}
					]
				}
			],
			"translation": {
				"content": [
					{
						"type": "paragraph",
						"children": [
							{
								"type": "text",
								"value": "人や物に帰属する性質や特徴。アイデンティティの属性は、"
							},
							{
