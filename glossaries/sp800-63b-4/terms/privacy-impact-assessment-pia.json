	"heading": "Privacy Impact Assessment (PIA)",
	"headingTranslation": {
		"text": "プライバシー影響評価 (PIA)",
		"sourceHash": "83990dafb18e7052a3b1177ca57d6d5ddb89744101c773c62dc1ccad269ec77d"
	},
	"definitions": [
		{
			"location": {
