			},
			"source": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "text",
							"value": "A characteristic of an authentication system or an "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "authenticator"
								}
							]
						},
						{
							"type": "text",
							"value": " that requires only one "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "authentication factor"
								}
							]
						},
						{
							"type": "text",
							"value": " (i.e., something you know, something you have, or something you are) for successful authentication."
						}
					]
				}
			],
			"translation": {
				"content": [
					{
						"type": "paragraph",
						"children": [
							{
								"type": "text",
								"value": "認証を成功させるために、1 つの"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "認証要素"
									}
								]
							},
							{
								"type": "text",
								"value": " (つまり、知っているもの・持っているもの・自分自身の特性のいずれか) だけを必要とする、認証システムや"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "認証器"
									}
								]
							},
							{
								"type": "text",
								"value": "の特性。"
							}
						]
					}
				],
				"sourceHash": "ab7d6d6a8b32f3c39b717591390c37533c0fa8291f7c4e7d1df57c02d58b6170"
			}
