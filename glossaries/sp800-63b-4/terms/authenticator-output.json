{
	"$schema": "../../../schemas/term.schema.json",
	"heading": "authenticator output",
	"headingTranslation": {
		"text": "認証器出力",
		"sourceHash": "655c0f3d1b446a6b3464e377bbae597897cf7e6f3783c4edcfc7af69198e4bd5"
	},
	"definitions": [
		{
			"location": {
				"url": "https://pages.nist.gov/800-63-4/sp800-63b.html#def-and-acr"
			},
			"source": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "text",
							"value": "The output value generated by an "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "authenticator"
								}
							]
						},
						{
							"type": "text",
							"value": ". The ability to generate valid authenticator outputs on demand proves that the "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "claimant"
								}
							]
						},
						{
							"type": "text",
							"value": " possesses and controls the authenticator. Protocol messages sent to the "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "verifier"
								}
							]
						},
						{
							"type": "text",
							"value": " depend on the authenticator output, but they may or may not explicitly contain it."
						}
					]
				}
			],
			"translation": {
				"content": [
					{
						"type": "paragraph",
						"children": [
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "認証器"
									}
								]
							},
							{
								"type": "text",
								"value": "が生成する出力値。有効な認証器出力を必要に応じて生成できることが、"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "claimant"
									}
								]
							},
							{
								"type": "text",
								"value": " がその認証器を所持し管理していることの証明になる。"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "verifier"
									}
								]
							},
							{
								"type": "text",
								"value": " に送られるプロトコルのメッセージは認証器出力に依存するが、認証器出力を明示的に含むとは限らない。"
							}
						]
					}
				],
				"sourceHash": "b08b4863fce5e7c06494b3e8036ae6fc39f56ecd303fa9ebdf207538864e8588"
			}
		}
	],
