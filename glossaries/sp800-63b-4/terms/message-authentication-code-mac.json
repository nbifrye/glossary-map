	"$schema": "../../../schemas/term.schema.json",
	"heading": "message authentication code (MAC)",
	"headingTranslation": {
		"text": "メッセージ認証コード (MAC)",
		"sourceHash": "a583f5d2ee15d6fe2bae5ad658869a3077413fc036d89e4fd0e8f0183e0e8915"
	},
	"definitions": [
		{
			"location": {
				"url": "https://pages.nist.gov/800-63-4/sp800-63b.html#def-and-acr"
			},
			"source": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "text",
							"value": "A cryptographic checksum on data that uses a "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "symmetric key"
								}
							]
						},
						{
							"type": "text",
							"value": " to detect both accidental and intentional modifications of the data. MACs provide "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "authenticity"
								}
							]
						},
						{
							"type": "text",
							"value": " and integrity protection but not "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "non-repudiation"
								}
							]
						},
						{
							"type": "text",
							"value": " protection."
						}
					]
				}
			],
			"translation": {
				"content": [
					{
						"type": "paragraph",
						"children": [
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "対称鍵"
									}
								]
							},
							{
								"type": "text",
								"value": "を使って、データに対する偶発的な改変と意図的な改変の両方を検出する、データの暗号チェックサム。MAC は"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "真正性"
									}
								]
							},
							{
								"type": "text",
								"value": "と完全性の保護を提供するが、"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "否認防止"
									}
								]
							},
							{
								"type": "text",
								"value": "の保護は提供しない。"
							}
						]
					}
				],
				"sourceHash": "733ccd92dbfc094497fa361d5f4dc5a44a2ad690d20f9d95c809d4a96c235eba"
			}
		}
	],
