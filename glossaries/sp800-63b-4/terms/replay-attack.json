							"children": [
								{
									"type": "text",
									"value": "claimant"
								}
							]
						},
						{
							"type": "text",
							"value": " and a "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "verifier"
								}
							]
						},
						{
							"type": "text",
							"value": " to masquerade as that claimant to the verifier or vice versa."
						}
					]
				}
			],
			"translation": {
				"content": [
					{
						"type": "paragraph",
						"children": [
							{
								"type": "text",
								"value": "正当な "
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "claimant"
									}
								]
							},
							{
								"type": "text",
								"value": " と "
							},
