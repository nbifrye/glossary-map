									"type": "text",
									"value": "claimed identity"
								}
							]
						},
						{
							"type": "text",
							"value": ". Identity evidence may be physical (e.g., a driver’s license) or digital (e.g., a mobile driver’s license or digital "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "assertion"
								}
							]
						},
						{
							"type": "text",
							"value": "). Evidence must support both "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "validation"
								}
							]
						},
						{
							"type": "text",
							"value": " (i.e., confirming "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "authenticity"
								}
							]
						},
						{
							"type": "text",
							"value": " and accuracy) and "
						},
						{
							"type": "emphasis",
							"children": [
								{
									"type": "text",
									"value": "verification"
								}
							]
						},
						{
							"type": "text",
							"value": " (i.e., confirming that the "
