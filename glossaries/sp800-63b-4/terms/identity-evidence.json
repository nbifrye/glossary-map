									"type": "text",
									"value": "applicant"
								}
							]
						},
						{
							"type": "text",
							"value": " is the true owner of the evidence)."
						}
					]
				}
			],
			"translation": {
				"content": [
					{
						"type": "paragraph",
						"children": [
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "主張されたアイデンティティ"
									}
								]
							},
							{
								"type": "text",
								"value": "が実在することを裏付ける情報や書類。identity evidence は、物理的なもの (例: 運転免許証) でも、デジタルのもの (例: モバイル運転免許証やデジタルの"
							},
