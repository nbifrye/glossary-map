									{
										"type": "text",
										"value": "アサーション"
									}
								]
							},
							{
								"type": "text",
								"value": ") でもよい。証拠は、"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "妥当性確認"
									}
								]
							},
							{
								"type": "text",
								"value": " (つまり、"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "真正性"
									}
								]
							},
							{
								"type": "text",
								"value": "と正確さの確認) と"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "検証"
									}
								]
							},
							{
								"type": "text",
								"value": " (つまり、"
							},
							{
								"type": "emphasis",
								"children": [
									{
										"type": "text",
										"value": "applicant"
									}
								]
							},
							{
								"type": "text",
								"value": " が証拠の正当な所有者であることの確認) の両方に対応しなければならない。"
							}
						]
					}
