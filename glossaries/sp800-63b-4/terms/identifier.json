									"type": "text",
									"value": "session"
								}
							]
						},
						{
							"type": "text",
							"value": ") within a given context and is never assigned to any other entity within that context."
						}
					]
				}
			],
			"translation": {
				"content": [
					{
						"type": "paragraph",
						"children": [
							{
								"type": "text",
								"value": "特定の文脈の中で、単一の一意な実体 (例: 個人・機器・"
